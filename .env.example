# Dialo CX Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# SUPABASE (NEW PROJECT)
# ============================================
# Get these from your new Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

# ============================================
# DEEPSEEK AI
# ============================================
# For AI classification - reuse existing or create new
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ============================================
# GEMINI AI (Optional)
# ============================================
# Alternative to DeepSeek/OpenAI for classification
GEMINI_API_KEY=your-gemini-api-key

# ============================================
# WATI (Multi-Tenant)
# ============================================
# NOTE: In production, these are stored per-tenant in database
# For development/testing, you can set defaults here
WATI_TENANT_ACCESS_TOKEN=your-wati-token
WATI_ENDPOINT=https://live-mt-server.wati.io/your-tenant-id

# Rate limit for /getMessages backfill calls (sliding window per-minute).
# Default 60 is well under Wati's documented 10 req per 10 sec cap.
# Lower this if you see repeated 429 errors during batch_messages_import.
WATI_RATE_LIMIT=60

# ============================================
# RAILWAY (Optional - for serverless deployment)
# ============================================
RAILWAY_API_KEY=your-railway-api-key
RAILWAY_APP_URL=https://your-app.up.railway.app

# ============================================
# AUTHENTICATION
# ============================================
# Admin credentials for Streamlit dashboard
# Generate password hash with: python scripts/generate_password_hash.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$your-bcrypt-hash-will-go-here

# Admin API key for internal operations
ADMIN_API_KEY=your-admin-api-key

# ============================================
# CLASSIFICATION CONFIGURATION
# ============================================
PRODUCTION_PROVIDER=deepseek
PRODUCTION_MODEL=deepseek-chat
PRODUCTION_BATCH_SIZE=20

# ============================================
# OPTIONAL: Third-party integrations (V2+)
# ============================================
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# MISTRAL_API_KEY=your-mistral-key
# META_ACCESS_TOKEN=your-meta-token
# META_APP_ID=your-app-id
# META_AD_ACCOUNT=your-ad-account
